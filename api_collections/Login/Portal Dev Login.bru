meta {
  name: Portal Dev Login
  type: http
  seq: 1
}

post {
  url: {{domain_url}}/api/lift/{{tenant}}/sessions
  body: json
  auth: apikey
}

auth:apikey {
  key: Authorization
  value: {{api_token}}
  placement: header
}

body:json {
  {
      "username": "{{username}}",
      "password": "{{password}}"
  }
  
}

script:pre-request {
  const { fetchAwsSecrets } = require('./fetch-aws-secrets');
  fetchAwsSecrets(bru, req)
}

script:post-response {
  expect(res.getStatus()).to.equal(200); 
  if (res.getStatus() === 200) { 
    bru.setVar("api_token", res.getHeader("x-auth-token")); 
  } 
  const responseData = res.getBody();
}

settings {
  encodeUrl: true
  timeout: 0
}
