meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{domain_url}}/api/lift/{{tenant}}/sessions
  body: json
  auth: apikey
}

auth:apikey {
  key: Authorization
  value: {{authToken}}
  placement: header
}

body:json {
  {
      "username": "{{username}}",
      "password": "{{password}}"
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200); 
  if (res.getStatus() === 200) { 
  bru.setEnvVar("authToken", res.getHeader("x-auth-token")); 
  } 
  const responseData = res.getBody();
}

settings {
  encodeUrl: true
  timeout: 0
}
